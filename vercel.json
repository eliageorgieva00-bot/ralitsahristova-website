{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ralitsahristova.com"
        }
      ],
      "destination": "https://ralitsahristova.com/:path*",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "https://ralitsahristova.com/za-advokata",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "https://ralitsahristova.com/za-advokata",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/documents/:file",
      "destination": "/:file"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
